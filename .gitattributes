# Normalise line endings.
#
# Shell scripts MUST be LF. A .sh file checked out with CRLF fails on
# Linux with "bad interpreter: /bin/bash^M" - which would silently break
# the backup job on the production server.
*.sh            text eol=lf

# Batch files must stay CRLF: cmd.exe can mis-parse labels and goto in
# a .cmd checked out with LF endings.
*.cmd           text eol=crlf
*.bat           text eol=crlf

# Everything else the project edits on Windows keeps CRLF locally and is
# stored as LF in the repository.
*.php           text
*.sql           text
*.css           text
*.js            text
*.md            text
*.json          text
.htaccess       text
.gitignore      text

# Binary - never touch.
*.phar          binary
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gz            binary
*.xlsx          binary
*.xls           binary
