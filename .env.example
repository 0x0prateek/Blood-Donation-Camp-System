# ═══════════════════════════════════════════════════════════════
# Blood Donor Management System — Environment Variables
# ═══════════════════════════════════════════════════════════════
#
# SETUP:
#   cp .env.example .env
#   Edit .env with your real values — it is git-ignored.
#   NEVER commit .env to version control.
#
# RAILWAY.APP:
#   Set these in the Railway service's "Variables" tab.
#   Railway injects them as real env vars — no .env file needed.

# ── Database ──────────────────────────────────────────────────
# On Railway: Use the MySQL plugin. Railway auto-injects these.
DB_HOST=db
DB_NAME=blood_donor_system
DB_USER=blooddonor
DB_PASS=change_me_to_a_strong_password
DB_ROOT_PASS=change_me_to_a_strong_root_password

# ── JWT Authentication ────────────────────────────────────────
# REQUIRED: Generate with: openssl rand -hex 64
# Must be at least 32 characters. A short secret breaks security.
JWT_SECRET=change_me_to_a_long_random_string_at_least_64_chars
JWT_EXPIRY_HOURS=2

# ── Application ───────────────────────────────────────────────
# Set APP_DEBUG=true only on a local dev machine.
# Never true in production — it prints stack traces to the browser.
APP_DEBUG=false
APP_TIMEZONE=Asia/Colombo

# ── URLs ──────────────────────────────────────────────────────
# The Vue frontend's origin, used for CORS Allow-Origin on the API.
# Dev: http://localhost
# Railway: https://your-app.up.railway.app
FRONTEND_URL=http://localhost:3000

# ── WhatsApp Cloud API (Meta) ─────────────────────────────────
# Get these from: https://developers.facebook.com/apps/ → WhatsApp → API Setup
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# ── SMS Gateway ───────────────────────────────────────────────
# Supported gateways: notify | twilio
SMS_GATEWAY=notify

# For Notify.lk:
#   SMS_API_KEY     = numeric User ID from notify.lk dashboard
#   SMS_API_SECRET  = API Key from notify.lk dashboard
#   SMS_SENDER_ID   = approved sender name (e.g. NotifyDEMO)
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=

# For Twilio:
#   SMS_API_KEY     = Account SID
#   SMS_API_SECRET  = Auth Token
#   SMS_SENDER_ID   = Twilio phone number (e.g. +19876543210)
