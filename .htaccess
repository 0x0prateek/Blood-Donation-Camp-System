# Blood Donor Management System - Apache Configuration
#
# NOTE: every protection in this file depends on the host honouring
# .htaccess (Apache with AllowOverride All). On nginx, or Apache with
# AllowOverride None, NONE of it applies and config.php becomes readable.
# Verify on the production host before deploying.

# Deny access to sensitive files
<FilesMatch "\.(sql|json|md|log|phar|lock|dist|example|ini|sh|bak)$">
    Require all denied
</FilesMatch>

# Deny access to config and includes
<FilesMatch "^(config\.php|config\.local\.php)$">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block dotfiles and dot-directories - .git, .env, .gitignore and
    # anything similar. These have no extension, so the FilesMatch rules
    # above never see them: /.git/config was served with HTTP 200 before
    # this rule existed, which exposed the entire repository history.
    # .well-known is excluded so ACME/Let's Encrypt still works.
    RewriteCond %{REQUEST_URI} !^/\.well-known/
    RewriteRule (^|/)\.[^/]+ - [F,L]

    # Nothing under uploads/ or vendor/ is ever meant to be requested
    # directly. Uploaded donor spreadsheets are personal health data.
    RewriteRule ^(uploads|vendor|backups|storage)/ - [F,L]

    # Redirect root to login page
    RewriteRule ^$ login.php [L]
</IfModule>

# Disable directory listing
Options -Indexes

# NOTE: do not add "php_flag engine off" here. This file applies to the
# whole application, so it disables PHP everywhere and Apache then serves
# .php files as plain text - leaking source, including config.php.
# Access to uploads/ is already denied by the RewriteRule above.

# Set default charset
AddDefaultCharset UTF-8

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"

    # X-XSS-Protection is deliberately NOT set. Modern browsers ignore it,
    # and its auditor was itself a source of vulnerabilities.

    # The app loads Bootstrap, jQuery, DataTables, Chart.js, SweetAlert2
    # and Font Awesome from CDNs, and uses inline <script> blocks on most
    # pages - so 'unsafe-inline' is required until those are extracted.
    # Tightening that is Phase 3 work; this still blocks object/frame
    # injection and restricts where scripts may come from at all.
    Header set Content-Security-Policy "default-src 'self'; \
script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.datatables.net https://cdnjs.cloudflare.com https://code.jquery.com; \
style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdn.datatables.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; \
font-src 'self' https://cdnjs.cloudflare.com https://fonts.gstatic.com data:; \
img-src 'self' data:; \
connect-src 'self'; \
object-src 'none'; \
frame-ancestors 'self'; \
base-uri 'self'; \
form-action 'self'"

    # HSTS only once HTTPS is actually in place - sending it over plain
    # HTTP does nothing, and enabling it before a certificate is working
    # locks users out of the site.
    <IfModule mod_ssl.c>
        Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS
    </IfModule>
</IfModule>
